# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication (Level 2)
# Any request to the API endpoints must provide this key in the X-API-Key header
API_KEY=koya_clinic_secret_key_2026

# Storage Configuration
# Persistent directory where JSON files (slots.json, bookings.json, idempotency.json) will reside
# In production with persistent disk/volume, set to mounted path e.g. /var/data or /data
DATA_DIR=src/data
